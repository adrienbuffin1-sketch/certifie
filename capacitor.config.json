{
  "appId": "com.certifie.app",
  "appName": "Certifié",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#5f1730",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#5f1730",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "LocalNotifications": {
      "iconColor": "#5f1730"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}